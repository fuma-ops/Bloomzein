# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase — public client credentials (safe to expose; protected by Row Level
# Security). If unset, src/lib/supabase.ts falls back to the project defaults.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Paddle Billing — Bloom+ checkout. These four are PUBLIC (they ship in the
# browser), so they're safe to commit; if unset, src/lib/paddle.ts falls back to
# the committed sandbox values. Set them here / in Vercel to switch environment.
VITE_PADDLE_ENV="sandbox"                          # "sandbox" | "production"
VITE_PADDLE_TOKEN="test_xxx"                        # Developer Tools → Authentication → client-side token
VITE_PADDLE_PRICE_MONTHLY="pri_xxx"                 # Catalog → your monthly price
VITE_PADDLE_PRICE_ANNUAL="pri_xxx"                  # Catalog → your annual price
# SECRETS — never put these in .env / any VITE_ var (they'd leak to the client).
# They live only in the Supabase Edge Function env (Edge Functions → Secrets):
#   PADDLE_WEBHOOK_SECRET   the "pdl_ntfset_…" signing secret of your webhook
#   (the server API key "…_apikey_…" isn't needed by this app at all)
